    // Helper: Shuffle Array (Acak Opsi Jawaban)
    function shuffleArray(array) {
      var arr = array.slice();
      for (var i = arr.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
      }
      return arr;
    }

    // Anti Curang: Event Listener Pindah Tab / Minimalize
    document.addEventListener("visibilitychange", function() {
      if (document.hidden && document.getElementById("start-screen").style.display === "none") {
        handleCheatViolation("Terdeteksi meninggalkan aplikasi kuis!");
      }
    });

    window.addEventListener("blur", function() {
      if (document.getElementById("start-screen").style.display === "none") {
        handleCheatViolation("Terdeteksi keluar dari jendela kuis!");
      }
    });

    // Anti Context Menu & Copy Paste
    document.addEventListener("contextmenu", function(e) { e.preventDefault(); });
    document.addEventListener("keydown", function(e) {
      if (e.key === "F12" || (e.ctrlKey && e.shiftKey && (e.key === "I" || e.key === "J")) || (e.ctrlKey && e.key === "u")) {
        e.preventDefault();
        handleCheatViolation("Terdeteksi mencoba membuka DevTools!");
      }
    });

    function handleCheatViolation(reason) {
      cheatCount++;
      clearInterval(timerInterval);
      
      var cheatScreen = document.getElementById("cheat-screen");
      var cheatTitle = document.getElementById("cheat-title");
      var cheatMsg = document.getElementById("cheat-msg");

      if (cheatCount >= MAX_CHEATS) {
        cheatTitle.innerText = "DISKUALIFIKASI!";
        cheatMsg.innerText = "Anda telah melanggar aturan anti-curang sebanyak 3 kali.\nKuis dihentikan secara otomatis.";
        cheatScreen.querySelector("button").style.display = "none";
        cheatScreen.style.display = "flex";
      } else {
        cheatTitle.innerText = `PERINGATAN CURANG (${cheatCount}/${MAX_CHEATS})`;
        cheatMsg.innerText = reason + "\n\nJangan tinggalkan kuis atau membuka tab lain!";
        cheatScreen.style.display = "flex";
      }
    }

    function resumeQuiz() {
      document.getElementById("cheat-screen").style.display = "none";
      if (!isAnswered) startTimer();
    }

    function startQuiz() {
      document.getElementById("start-screen").style.display = "none";
      initStatusDots();
      loadQuestion();
    }

    function initStatusDots() {
      var container = document.getElementById("status-dots");
      container.innerHTML = "";
      for (var i = 0; i < allQuestions.length; i++) {
        var dot = document.createElement("div");
        dot.className = "status-dot";
        dot.id = "dot-" + i;
        container.appendChild(dot);
      }
    }

    function updateStatusDots() {
      for (var i = 0; i < allQuestions.length; i++) {
        var dot = document.getElementById("dot-" + i);
        if (i === currentQIndex) {
          dot.className = "status-dot active";
        } else if (userAnswers[i] === true) {
          dot.className = "status-dot correct";
        } else if (userAnswers[i] === false) {
          dot.className = "status-dot wrong";
        } else {
          dot.className = "status-dot";
        }
      }
      // Auto Scroll Dot Status Aktif
      var activeDot = document.getElementById("dot-" + currentQIndex);
      if (activeDot) {
        activeDot.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    }

    function loadQuestion() {
      clearInterval(timerInterval);
      isAnswered = false;
      timeLeft = QUESTION_TIME;

      var qData = allQuestions[currentQIndex];
      document.getElementById("q-counter").innerText = `Soal ${currentQIndex + 1} / ${allQuestions.length}`;
      document.getElementById("question-box").innerText = (currentQIndex + 1) + ". " + qData.q;
      document.getElementById("next-btn").style.display = "none";

      // Acak pilihan jawaban
      var shuffledOptions = shuffleArray(qData.options);
      var grid = document.getElementById("options-grid");
      grid.innerHTML = "";

      var prefixes = ["A", "B", "C", "D"];
      shuffledOptions.forEach(function(optText, idx) {
        var btn = document.createElement("button");
        btn.className = "opt-btn";
        btn.onclick = function() { selectAnswer(btn, optText, qData.correctText); };
        
        btn.innerHTML = `
          <div class="opt-prefix">${prefixes[idx]}</div>
          <div>${optText}</div>
        `;
        grid.appendChild(btn);
      });

      updateStatusDots();
      startTimer();
    }

    function startTimer() {
      updateTimerUI();
      timerInterval = setInterval(function() {
        timeLeft--;
        updateTimerUI();

        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          timeOutAnswer();
        }
      }, 1000);
    }

    function updateTimerUI() {
      var minutes = Math.floor(timeLeft / 60);
      var seconds = timeLeft % 60;
      var timeStr = (minutes < 10 ? "0" : "") + minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
      
      document.getElementById("timer-text").innerText = timeStr;
      
      var percentage = (timeLeft / QUESTION_TIME) * 100;
      var bar = document.getElementById("timer-bar");
      bar.style.width = percentage + "%";

      if (timeLeft <= 15) {
        bar.style.background = "#e63946";
      } else if (timeLeft <= 45) {
        bar.style.background = "#e76f51";
      } else {
        bar.style.background = "linear-gradient(90deg, #2a9d8f, #e76f51)";
      }
    }

    function selectAnswer(selectedBtn, selectedText, correctText) {
      if (isAnswered) return;
      isAnswered = true;
      clearInterval(timerInterval);

      var isCorrect = (selectedText === correctText);
      userAnswers[currentQIndex] = isCorrect;

      var allBtns = document.querySelectorAll(".opt-btn");
      allBtns.forEach(function(btn) {
        btn.disabled = true;
        var btnText = btn.children[1].innerText;
        if (btnText === correctText) {
          btn.classList.add("correct");
        } else if (btn === selectedBtn && !isCorrect) {
          btn.classList.add("wrong");
        }
      });

      if (isCorrect) {
        // Diubah menjadi 1 poin tiap soal benar
        totalScore += 1;
        document.getElementById("score-badge").innerText = "Poin: " + totalScore;
      }

      updateStatusDots();
      showNextButton();
    }

    function timeOutAnswer() {
      if (isAnswered) return;
      isAnswered = true;
      userAnswers[currentQIndex] = false;

      var qData = allQuestions[currentQIndex];
      var allBtns = document.querySelectorAll(".opt-btn");
      
      allBtns.forEach(function(btn) {
        btn.disabled = true;
        var btnText = btn.children[1].innerText;
        if (btnText === qData.correctText) {
          btn.classList.add("correct");
        }
      });

      updateStatusDots();
      showNextButton();
    }

    function showNextButton() {
      var nextBtn = document.getElementById("next-btn");
      if (currentQIndex < allQuestions.length - 1) {
        nextBtn.innerText = "Soal Berikutnya ➔";
      } else {
        nextBtn.innerText = "SELESAI & LIHAT HASIL 🏆";
      }
      nextBtn.style.display = "block";
    }

    function nextQuestion() {
      if (currentQIndex < allQuestions.length - 1) {
        currentQIndex++;
        loadQuestion();
      } else {
        finishQuiz();
      }
    }

