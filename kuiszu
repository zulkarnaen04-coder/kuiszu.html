      { q: "Bernyanyi secara bersama-sama dengan satu suara melodi yang sama dinamakan...", options: ["Bernyanyi Unisono", "Bernyanyi Acappella", "Bernyanyi Canon", "Bernyanyi Solo"], correctText: "Bernyanyi Unisono" },
      { q: "Tanah tumpah darahku, pada lagu Indonesia Raya, KU berada pada hitungan ...", options: ["1", "3", "4", "2"], correctText: "1" },
      { q: "Teknik bernyanyi bersusulan antara kelompok satu dengan kelompok lain dinamakan lagu...", options: ["Canon", "Unisono", "Harmoni", "Duet"], correctText: "Canon" },
      { q: "Indonesia Tanah Airku, pada lagu Indonesia Raya, SIA berada pada hitungan ...", options: ["1", "3", "4", "2"], correctText: "2" }
