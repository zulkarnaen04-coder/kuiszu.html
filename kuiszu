    .q-counter { font-size: 16px; font-weight: bold; color: #f4a261; }
    .score-badge { background: #2a9d8f; padding: 4px 12px; border-radius: 15px; font-size: 14px; font-weight: bold; color: #fff; }
    
    /* Timer UI (1 Menit 30 Detik = 90s) */
    .timer-container { width: 100%; background: #0d1b2a; border-radius: 10px; height: 16px; border: 1px solid #415a77; overflow: hidden; position: relative; }
    .timer-bar { height: 100%; width: 100%; background: linear-gradient(90deg, #2a9d8f, #e76f51); transition: width 1s linear, background-color 0.5s; }
    .timer-text { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 11px; font-weight: bold; color: #fff; text-shadow: 1px 1px 2px #000; }

    /* Layout Main HP */
    .main-card { background: #1b263b; border: 2px solid #415a77; border-radius: 15px; padding: 15px; box-shadow: 0 6px 15px rgba(0,0,0,0.4); flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
    .question-box { background: #0d1b2a; border: 1px solid #f4a261; padding: 15px; border-radius: 10px; font-size: 16px; font-weight: bold; line-height: 1.4; text-align: center; min-height: 90px; display: flex; align-items: center; justify-content: center; color: #f4a261; margin-bottom: 15px; }

    /* Opsi Jawaban Grid HP */
    .options-grid { display: flex; flex-direction: column; gap: 10px; }
    .opt-btn { background: #2a3d54; border: 2px solid #415a77; color: #fff; padding: 12px 15px; border-radius: 10px; font-size: 14px; font-weight: 600; text-align: left; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; -webkit-tap-highlight-color: transparent; }
    .opt-btn:active { transform: scale(0.98); }
    .opt-prefix { background: #f4a261; color: #000; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 12px; flex-shrink: 0; font-size: 13px; }
    
    .opt-btn.correct { background: #2a9d8f !important; border-color: #2a9d8f !important; color: #fff !important; }
    .opt-btn.correct .opt-prefix { background: #fff; color: #2a9d8f; }
    .opt-btn.wrong { background: #e63946 !important; border-color: #e63946 !important; color: #fff !important; }
    .opt-btn.wrong .opt-prefix { background: #fff; color: #e63946; }

    /* Action Controls */
    .footer-actions { margin-top: 15px; text-align: center; }
    .next-btn { background: #f4a261; color: #000; font-size: 16px; font-weight: bold; padding: 12px 30px; border: none; border-radius: 25px; cursor: pointer; width: 100%; text-transform: uppercase; letter-spacing: 1px; display: none; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
    .next-btn:active { background: #e76f51; color: #fff; }

    /* Status Grid Mini untuk HP */
    .status-bar-mini { display: flex; justify-content: flex-start; gap: 4px; margin-top: 10px; overflow-x: auto; padding-bottom: 5px; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #415a77; flex-shrink: 0; }
    .status-dot.active { background: #f4a261; transform: scale(1.3); }
    .status-dot.correct { background: #2a9d8f; }
    .status-dot.wrong { background: #e63946; }

    /* Start Screen Overlay */
    .start-screen { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #0d1b2a; z-index: 8888; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 20px; text-align: center; }
    .start-title { color: #f4a261; font-size: 24px; font-weight: bold; margin-bottom: 10px; }
    .start-desc { color: #a8dadc; font-size: 14px; margin-bottom: 25px; line-height: 1.5; }
    .rule-box { background: #1b263b; border: 1px solid #415a77; padding: 15px; border-radius: 10px; text-align: left; font-size: 13px; margin-bottom: 25px; width: 100%; max-width: 350px; }
    .rule-box li { margin-bottom: 8px; color: #fff; }
    .start-btn { background: #2a9d8f; color: #fff; font-size: 18px; font-weight: bold; padding: 15px 40px; border: none; border-radius: 30px; cursor: pointer; box-shadow: 0 4px 12px rgba(42,157,143,0.4); }
  </style>
</head>
