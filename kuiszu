      { q: "Kombinasi tangan kanan dan tangan kiri pada hitungan 2 dan 4 mengimitasi permainan...", options: ["Bass drum dan Hi-hat", "Hi-hat dan Snare drum", "Crash Cymbal saja", "Ride Cymbal saja"], correctText: "Hi-hat dan Snare drum" },
      { q: "Kriteria siswa yang dipilih menjadi pemain drumset adalah...", options: ["Siswa yang bersuara paling keras", "Siswa yang berhasil melakukan simulasi drumset sesuai tempo", "Siswa yang duduk di barisan depan", "Siswa yang paling cepat menghafal lirik"], correctText: "Siswa yang berhasil melakukan simulasi drumset sesuai tempo" },
      { q: "Mengapa koordinasi antara tangan dan kaki sangat penting bagi seorang pemain drum?", options: ["Agar lagu terdengar lebih nyaring", "Untuk menjaga ritme dan tempo lagu tetap stabil", "Agar penampilan terlihat menarik di proyektor", "Untuk menentukan tinggi nada instrumen lain"], correctText: "Untuk menjaga ritme dan tempo lagu tetap stabil" },
      { q: "Jika metronom diatur 60 BPM, berapa kali kaki kanan menginjak bass drum dalam 1 menit (hitungan 1 dan 3)?", options: ["15 kali", "30 kali", "60 kali", "120 kali"], correctText: "30 kali" },
      { q: "Tingkat kesulitan tertinggi pada latihan simulasi drumset terletak pada...", options: ["Menghafal angka 1 sampai 4", "Memisahkan gerak tangan dan kaki secara independen", "Memegang stik drum", "Membaca teks di layar proyektor"], correctText: "Memisahkan gerak tangan dan kaki secara independen" },
      { q: "Peran utama drumset dalam lagu ansambel seperti \"Ibu Kita Kartini\" adalah...", options: ["Memainkan melodi utama", "Menjaga tempo dan memberikan fondasi ritmik", "Mengisi harmoni akor", "Menyanyikan syair lagu"], correctText: "Menjaga tempo dan memberikan fondasi ritmik" },

      { q: "Media pendukung yang digunakan guru saat latihan menyanyi lagu Ibu Kita Kartini adalah...", options: ["Rekaman vokal asli", "Musik Minus One dan Layar Proyektor", "Partitur kertas tanpa audio", "Radio FM"], correctText: "Musik Minus One dan Layar Proyektor" },
      { q: "Pengertian dari musik Minus One adalah...", options: ["Musik pengiring tanpa jalurnya vokal utama", "Musik yang hanya berisi instrumen drum saja", "Musik yang temponya dikurangi jadi sangat lambat", "Rekaman lagu tanpa instrumen musik"], correctText: "Musik pengiring tanpa jalurnya vokal utama" },
