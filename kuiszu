<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>KUIS MUSIK KELAS 7</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; user-select: none; -webkit-user-select: none; }
    body { background: linear-gradient(135deg, #0d1b2a, #1b263b); color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; padding: 10px; overflow-x: hidden; }
    
    /* Anti-Cheat Overlay */
    .cheat-warning { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(230, 57, 70, 0.95); z-index: 9999; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 20px; }
    .cheat-warning h1 { font-size: 28px; color: #fff; margin-bottom: 15px; text-transform: uppercase; }
    .cheat-warning p { font-size: 16px; color: #f8f9fa; margin-bottom: 20px; line-height: 1.5; }
    .cheat-warning button { background: #fff; color: #e63946; font-size: 18px; font-weight: bold; padding: 12px 30px; border: none; border-radius: 25px; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }

    /* Header */
    .header { background: #1b263b; border-radius: 12px; padding: 12px 15px; border: 2px solid #f4a261; box-shadow: 0 4px 10px rgba(0,0,0,0.3); margin-bottom: 15px; }
    .top-info { display: flex; justify-content: space-between; align-items: center; }
    .student-info { font-size: 16px; color: #a8dadc; margin-bottom: 6px; font-weight: 600; }
    .q-counter { font-size: 16px; font-weight: bold; color: #f4a261; }
    .score-badge { background: #2a9d8f; padding: 6px 16px; border-radius: 15px; font-size: 16px; font-weight: bold; color: #fff; }

    /* Layout Ubin (Grid Tile Layout) */
    .tiles-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(65px, 1fr)); gap: 10px; padding: 10px; background: #1b263b; border: 2px solid #415a77; border-radius: 15px; flex-grow: 1; max-height: calc(100vh - 180px); overflow-y: auto; }
    .tile-btn { background: #2a3d54; border: 2px solid #415a77; border-radius: 10px; color: #fff; font-size: 16px; font-weight: bold; height: 60px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 6px rgba(0,0,0,0.2); }
    .tile-btn:active { transform: scale(0.95); }
    .tile-btn:hover { background: #3a506b; border-color: #f4a261; }
    .tile-btn.correct { background: #2a9d8f !important; border-color: #2a9d8f !important; color: #fff !important; cursor: not-allowed; }
    .tile-btn.wrong { background: #e63946 !important; border-color: #e63946 !important; color: #fff !important; cursor: not-allowed; }

    /* Finish Action Button */
    .finish-bar { margin-top: 15px; text-align: center; }
    .finish-btn { background: #2a9d8f; color: #fff; font-size: 18px; font-weight: bold; padding: 14px 30px; border: none; border-radius: 25px; cursor: pointer; width: 100%; max-width: 400px; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); display: none; }

    /* Modal Dialog Soal */
    .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.85); z-index: 9000; justify-content: center; align-items: center; padding: 15px; }
    .modal-card { background: #1b263b; border: 2px solid #f4a261; border-radius: 15px; padding: 20px; width: 100%; max-width: 500px; box-shadow: 0 8px 20px rgba(0,0,0,0.6); display: flex; flex-direction: column; position: relative; max-height: 90vh; overflow-y: auto; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .modal-title { font-size: 16px; font-weight: bold; color: #f4a261; }
    .close-modal-btn { background: #e63946; color: #fff; border: none; font-weight: bold; padding: 4px 10px; border-radius: 5px; cursor: pointer; }

    /* Timer UI Dalam Modal */
    .timer-container { width: 100%; background: #0d1b2a; border-radius: 10px; height: 16px; border: 1px solid #415a77; overflow: hidden; position: relative; margin-bottom: 15px; }
    .timer-bar { height: 100%; width: 100%; background: linear-gradient(90deg, #2a9d8f, #e76f51); transition: width 1s linear, background-color 0.5s; }
    .timer-text { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 11px; font-weight: bold; color: #fff; text-shadow: 1px 1px 2px #000; }

    /* Pertanyaan & Opsi Jawaban */
    .question-box { background: #0d1b2a; border: 1px solid #f4a261; padding: 15px; border-radius: 10px; font-size: 16px; font-weight: bold; line-height: 1.4; text-align: center; min-height: 80px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #f4a261; margin-bottom: 15px; }
    .audio-btn { background: #e76f51; color: #fff; border: none; padding: 10px 20px; font-size: 15px; font-weight: bold; border-radius: 20px; cursor: pointer; margin-top: 12px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.3); }
    .audio-btn:active { transform: scale(0.95); }

    .options-grid { display: flex; flex-direction: column; gap: 10px; }
    .opt-btn { background: #2a3d54; border: 2px solid #415a77; color: #fff; padding: 12px 15px; border-radius: 10px; font-size: 15px; font-weight: 600; text-align: center; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; -webkit-tap-highlight-color: transparent; }
    .opt-btn:active { transform: scale(0.98); }
    .opt-btn:hover { background: #3a506b; border-color: #f4a261; }
    .opt-btn.correct { background: #2a9d8f !important; border-color: #2a9d8f !important; color: #fff !important; }
    .opt-btn.wrong { background: #e63946 !important; border-color: #e63946 !important; color: #fff !important; }

    /* Start Screen Overlay */
    .start-screen { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #0d1b2a; z-index: 9998; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 20px; text-align: center; overflow-y: auto; }
    .start-title { color: #f4a261; font-size: 28px; font-weight: bold; margin-bottom: 8px; }
    .start-desc { color: #a8dadc; font-size: 13px; margin-bottom: 20px; line-height: 1.4; }
    
    /* Input Form Siswa */
    .student-form { background: #1b263b; border: 2px solid #f4a261; padding: 15px; border-radius: 12px; width: 100%; max-width: 350px; margin-bottom: 15px; text-align: left; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: 13px; color: #f4a261; font-weight: bold; margin-bottom: 5px; }
    .form-group input { width: 100%; padding: 10px 12px; font-size: 14px; border-radius: 8px; border: 1px solid #415a77; background: #0d1b2a; color: #fff; outline: none; user-select: text; -webkit-user-select: text; }
    .form-group input:focus { border-color: #f4a261; }

    .rule-box { background: #1b263b; border: 1px solid #415a77; padding: 12px; border-radius: 10px; text-align: left; font-size: 12px; margin-bottom: 20px; width: 100%; max-width: 350px; }
    .rule-box li { margin-bottom: 6px; color: #fff; }
    .start-btn { background: #2a9d8f; color: #fff; font-size: 18px; font-weight: bold; padding: 14px 40px; border: none; border-radius: 30px; cursor: pointer; box-shadow: 0 4px 12px rgba(42,157,143,0.4); width: 100%; max-width: 350px; }
  </style>
</head>
<body>

  <!-- Screen Peringatan Anti Curang -->
  <div class="cheat-warning" id="cheat-screen">
    <h1 id="cheat-title">PERINGATAN CURANG!</h1>
    <p id="cheat-msg">Terdeteksi meninggalkan aplikasi / membuka tab lain!</p>
    <button onclick="resumeQuiz()">LANJUTKAN KUIS</button>
  </div>

  <!-- Screen Awal / Start -->
  <div class="start-screen" id="start-screen">
    <div class="start-title">KUIS MUSIK SMP</div>
    <div class="start-desc">Sistem Kuis Mode Ubin (Grid) Anti-Curang & Terdata di Google Sheets</div>
    
    <div class="student-form">
      <div class="form-group">
        <label for="student-name">Nama Lengkap Siswa:</label>
        <input type="text" id="student-name" placeholder="Masukkan nama lengkap..." autocomplete="off">
      </div>
      <div class="form-group" style="margin-bottom:0;">
        <label for="student-class">Kelas:</label>
        <input type="text" id="student-class" placeholder="Contoh: 7A / 7.1" autocomplete="off">
      </div>
    </div>

    <div class="rule-box">
      <strong style="color:#f4a261; display:block; margin-bottom:6px;">PERATURAN KUIS:</strong>
      <ul>
        <li>🟦 <strong>Mode Ubin:</strong> Bebas memilih ubin mana saja untuk dijawab terlebih dahulu.</li>
        <li>⏱️ <strong>Waktu Soal:</strong> 1 Menit (60 Detik) per soal yang dibuka.</li>
        <li>🔊 <strong>Soal Bersuara:</strong> Tekan tombol speaker untuk mendengarkan audio nada/ritme.</li>
        <li>🚫 <strong>Dilarang Pindah Aplikasi:</strong> Keluar browser / tab lain terdeteksi curang.</li>
        <li>⚠️ <strong>Batas Pelanggaran:</strong> Maksimal 3 kali sebelum didiskualifikasi!</li>
        <li>📊 <strong>Rekap Otomatis:</strong> Hasil kuis langsung terkirim ke Google Sheets guru.</li>
      </ul>
    </div>
    <button class="start-btn" onclick="validateAndStart()">MULAI KUIS</button>
  </div>

  <!-- Header Section -->
  <div class="header">
    <div class="student-info" id="display-student-info">Siswa: - | Kelas: -</div>
    <div class="top-info">
      <div class="q-counter" id="q-counter">Terjawab: 0 / 50 Soal</div>
      <div class="score-badge" id="score-badge">Skor: 0</div>
    </div>
  </div>

  <!-- Grid Ubin Soal -->
  <div class="tiles-container" id="tiles-container"></div>

  <!-- Tombol Selesai Kuis -->
  <div class="finish-bar">
    <button class="finish-btn" id="finish-btn" onclick="finishQuiz()">KIRIM & LIHAT HASIL 🏆</button>
  </div>

  <!-- Modal Dialog Pertanyaan -->
  <div class="modal-overlay" id="modal-overlay">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title">Pertanyaan Soal</div>
        <button class="close-modal-btn" onclick="closeModalDirectly()">✕ Batal</button>
      </div>

      <div class="timer-container">
        <div class="timer-bar" id="timer-bar"></div>
        <div class="timer-text" id="timer-text">01:00</div>
      </div>

      <div class="question-box" id="question-box">
        <span id="question-text">Memuat soal...</span>
        <button id="audio-play-btn" class="audio-btn" style="display:none;" onclick="playQuestionSound()">
          🔊 Putar Suara Nada / Ritme
        </button>
      </div>

      <div class="options-grid" id="options-grid"></div>
    </div>
  </div>

  <script>
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwLlFjDUN03qJ4oRzW4RXMetplgcasO4AW-6HZv6OduRg8IRqiDYihlj37hYBK-HZJm/exec";

    // WEB AUDIO SYNTHESIZER ENGINE (DAPAT DIJALANKAN DI SEMUA BROWSER)
    let audioCtx = null;

    function initAudioContext() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playAudioPattern(audioData) {
      initAudioContext();
      if (!audioCtx) return;

      const bpm = 60; 
      const beatSec = 60 / bpm;
      const now = audioCtx.currentTime + 0.05;

      if (audioData.type === 'single') {
        playTone(audioData.duration * beatSec, now, audioData.instrument || 'sine');
      } else if (audioData.type === 'pattern') {
        let currentOffset = 0;
        audioData.notes.forEach(note => {
          if (note.dur > 0) {
            playTone(note.dur * beatSec, now + currentOffset, note.inst || 'sine');
          }
          currentOffset += note.step * beatSec;
        });
      } else if (audioData.type === 'inst') {
        playInstrumentSound(audioData.instrument, now);
      }
    }

    function playTone(dur, startTime, inst = 'sine') {
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();

      if (inst === 'violin') {
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(440, startTime);
        gain.gain.setValueAtTime(0.01, startTime);
        gain.gain.linearRampToValueAtTime(0.3, startTime + 0.1);
        gain.gain.setValueAtTime(0.3, startTime + Math.max(0.1, dur - 0.1));
        gain.gain.linearRampToValueAtTime(0.001, startTime + dur);
      } else if (inst === 'guitar') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(329.63, startTime);
        gain.gain.setValueAtTime(0.4, startTime);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + dur);
      } else {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(523.25, startTime);
        gain.gain.setValueAtTime(0.3, startTime);
        gain.gain.linearRampToValueAtTime(0.001, startTime + dur);
      }

      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(startTime);
      osc.stop(startTime + dur);
    }

    function playInstrumentSound(inst, startTime) {
      if (!audioCtx) return;
      if (inst === 'drum') {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.frequency.setValueAtTime(150, startTime);
        osc.frequency.exponentialRampToValueAtTime(0.01, startTime + 0.25);
        gain.gain.setValueAtTime(0.8, startTime);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.25);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(startTime);
        osc.stop(startTime + 0.25);
      } else if (inst === 'guitar') {
        playTone(1.5, startTime, 'guitar');
      } else if (inst === 'violin') {
        playTone(2.0, startTime, 'violin');
      }
    }

    // BANK SOAL AUDIO (RITME & INSTRUMEN)
    var audioQuestionsPool = [
      { q: "Dengarkan suara bunyi berikut! Berapa jumlah ketukan nilai durasi bunyi tunggal yang baru saja kamu dengar?", options: ["1 Ketukan", "2 Ketukan", "3 Ketukan", "4 Ketukan"], correctText: "1 Ketukan", audio: { type: "single", duration: 1.0 } },
      { q: "Dengarkan suara bunyi berikut! Berapa jumlah ketukan nilai durasi bunyi tunggal tersebut?", options: ["1 Ketukan", "2 Ketukan", "3 Ketukan", "4 Ketukan"], correctText: "2 Ketukan", audio: { type: "single", duration: 2.0 } },
      { q: "Dengarkan suara bunyi berikut! Berapa jumlah ketukan nilai durasi bunyi panjang tersebut?", options: ["1 Ketukan", "2 Ketukan", "3 Ketukan", "4 Ketukan"], correctText: "3 Ketukan", audio: { type: "single", duration: 3.0 } },
      { q: "Dengarkan suara bunyi berikut! Berapa jumlah ketukan nilai durasi bunyi paling panjang yang terdengar?", options: ["1 Ketukan", "2 Ketukan", "3 Ketukan", "4 Ketukan"], correctText: "4 Ketukan", audio: { type: "single", duration: 4.0 } },
      
      { q: "Dengarkan kombinasi pola bunyi dalam 1 birama 4/4 berikut! Pola ketukan bunyi yang terdengar adalah...", options: ["1 ketukan - 1 ketukan - 2 ketukan", "2 ketukan - 2 ketukan", "1 ketukan - 3 ketukan", "4 ketukan penuh"], correctText: "1 ketukan - 1 ketukan - 2 ketukan", audio: { type: "pattern", notes: [{dur: 1, step: 1}, {dur: 1, step: 1}, {dur: 2, step: 2}] } },
      { q: "Dengarkan kombinasi pola bunyi berikut! Nilai gabungan bunyi yang kamu dengar dalam 1 birama adalah...", options: ["2 ketukan - 1 ketukan - 1 ketukan", "1 ketukan - 1 ketukan - 1 ketukan - 1 ketukan", "3 ketukan - 1 ketukan", "2 ketukan - 2 ketukan"], correctText: "2 ketukan - 1 ketukan - 1 ketukan", audio: { type: "pattern", notes: [{dur: 2, step: 2}, {dur: 1, step: 1}, {dur: 1, step: 1}] } },
      { q: "Dengarkan pola ritme berikut! Pola gabungan bunyi yang baru saja dimainkan adalah...", options: ["1 ketukan - 2 ketukan - 1 ketukan", "1 ketukan - 1 ketukan - 2 ketukan", "2 ketukan - 2 ketukan", "3 ketukan - 1 ketukan"], correctText: "1 ketukan - 2 ketukan - 1 ketukan", audio: { type: "pattern", notes: [{dur: 1, step: 1}, {dur: 2, step: 2}, {dur: 1, step: 1}] } },
      { q: "Dengarkan gabungan pola bunyi berikut! Struktur ritme dalam 1 birama tersebut adalah...", options: ["3 ketukan - 1 ketukan", "1 ketukan - 3 ketukan", "2 ketukan - 2 ketukan", "1 ketukan - 1 ketukan - 2 ketukan"], correctText: "3 ketukan - 1 ketukan", audio: { type: "pattern", notes: [{dur: 3, step: 3}, {dur: 1, step: 1}] } },
      { q: "Dengarkan kombinasi ritme 1 birama 4/4 berikut! Pola bunyi yang dimainkan adalah...", options: ["4 bunyi masing-masing 1 ketukan", "2 bunyi masing-masing 2 ketukan", "1 bunyi bernilai 4 ketukan", "1 bunyi bernilai 3 ketukan & diam 1 ketukan"], correctText: "4 bunyi masing-masing 1 ketukan", audio: { type: "pattern", notes: [{dur: 1, step: 1}, {dur: 1, step: 1}, {dur: 1, step: 1}, {dur: 1, step: 1}] } },
      
      { q: "Dengarkan alur bunyi dalam 2 birama 4/4 berikut! Gabungan durasi bunyi antar birama tersebut adalah...", options: ["Birama 1: (2+2 ketukan), Birama 2: (4 ketukan)", "Birama 1: (1+1+1+1 ketukan), Birama 2: (2+2 ketukan)", "Birama 1: (3+1 ketukan), Birama 2: (2+2 ketukan)", "Birama 1: (4 ketukan), Birama 2: (1+1+2 ketukan)"], correctText: "Birama 1: (2+2 ketukan), Birama 2: (4 ketukan)", audio: { type: "pattern", notes: [{dur: 2, step: 2}, {dur: 2, step: 2}, {dur: 4, step: 4}] } },
      { q: "Dengarkan ritme dua birama berikut! Urutan gabungan bunyinya adalah...", options: ["Birama 1: (1+1+2 ketukan), Birama 2: (2+2 ketukan)", "Birama 1: (2+2 ketukan), Birama 2: (1+1+1+1 ketukan)", "Birama 1: (4 ketukan), Birama 2: (4 ketukan)", "Birama 1: (1+3 ketukan), Birama 2: (2+2 ketukan)"], correctText: "Birama 1: (1+1+2 ketukan), Birama 2: (2+2 ketukan)", audio: { type: "pattern", notes: [{dur: 1, step: 1}, {dur: 1, step: 1}, {dur: 2, step: 2}, {dur: 2, step: 2}, {dur: 2, step: 2}] } },
      { q: "Dengarkan 2 birama audio berikut! Bunyi yang dimainkan secara berurutan adalah...", options: ["Birama 1: 4 ketukan penuh | Birama 2: 4 ketukan penuh", "Birama 1: 2 ketukan | Birama 2: 2 ketukan", "Birama 1: 1 ketukan | Birama 2: 3 ketukan", "Birama 1: 3 ketukan | Birama 2: 1 ketukan"], correctText: "Birama 1: 4 ketukan penuh | Birama 2: 4 ketukan penuh", audio: { type: "pattern", notes: [{dur: 4, step: 4}, {dur: 4, step: 4}] } },
      { q: "Dengarkan ritme gabungan dua birama ini! Struktur ketukan bunyinya adalah...", options: ["Birama 1: (1+1+1+1 ketukan), Birama 2: (1+1+2 ketukan)", "Birama 1: (2+2 ketukan), Birama 2: (3+1 ketukan)", "Birama 1: (4 ketukan), Birama 2: (2+2 ketukan)", "Birama 1: (1+3 ketukan), Birama 2: (1+1+1+1 ketukan)"], correctText: "Birama 1: (1+1+1+1 ketukan), Birama 2: (1+1+2 ketukan)", audio: { type: "pattern", notes: [{dur: 1, step: 1}, {dur: 1, step: 1}, {dur: 1, step: 1}, {dur: 1, step: 1}, {dur: 1, step: 1}, {dur: 1, step: 1}, {dur: 2, step: 2}] } },

      { q: "Dengarkan warna suara (timbre) audio berikut! Suara instrumen musik yang dimainkan adalah...", options: ["Gitar", "Biola", "Drum / Perkusi", "Angklung"], correctText: "Biola", audio: { type: "inst", instrument: "violin" } },
      { q: "Dengarkan warna suara instrumen berikut! Karakteristik bunyi tersebut milik instrumen...", options: ["Gitar", "Biola", "Drum / Perkusi", "Terompet"], correctText: "Gitar", audio: { type: "inst", instrument: "guitar" } },
      { q: "Dengarkan suara hentakan audio berikut! Alat musik ritmis yang menghasilkan bunyi tersebut adalah...", options: ["Drum / Kick Bass", "Biola", "Gitar Akustik", "Piano"], correctText: "Drum / Kick Bass", audio: { type: "inst", instrument: "drum" } },
      { q: "Dengarkan sampel instrumen musik gesek berikut! Alat musik apakah ini?", options: ["Biola (Violin)", "Gitar", "Drumset", "Angklung"], correctText: "Biola (Violin)", audio: { type: "inst", instrument: "violin" } },
      { q: "Dengarkan suara petikan alat musik berikut! Instrumen melodis/harmonis yang dimaksud adalah...", options: ["Gitar", "Biola", "Drum", "Seruling"], correctText: "Gitar", audio: { type: "inst", instrument: "guitar" } },
      { q: "Dengarkan pola bunyi gesekan panjang berikut! Alat musik gesek yang mampu menghasilkan durasi nada panjang ini adalah...", options: ["Biola", "Drum", "Gitar", "Kendang"], correctText: "Biola", audio: { type: "inst", instrument: "violin" } },
      { q: "Dengarkan denyut ritmis berikut! Peran instrumen ritmis yang mendominasi seperti audio ini adalah...", options: ["Drum / Perkusi", "Gitar Akustik", "Biola", "Penyanyi Vokal"], correctText: "Drum / Perkusi", audio: { type: "inst", instrument: "drum" } }
    ];

    // BANK SOAL TEORI MUSIK
    var rawQuestionsPool = [
