    function shuffleArray(array) {
      var arr = array.slice();
      for (var i = arr.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
      }
      return arr;
    }

    // Menggabungkan seluruh bank soal (audio + teori), mengacak seluruhnya, lalu mengambil tepat 50 soal
    var combinedPool = audioQuestionsPool.concat(rawQuestionsPool);
    var selectedQuestions = shuffleArray(combinedPool).slice(0, 50);

    var studentName = "";
    var studentClass = "";
    var currentQIndex = -1;
    var correctAnswersCount = 0;
    var answeredCount = 0;
    var timerInterval = null;
    var QUESTION_TIME = 60;
    var timeLeft = QUESTION_TIME;
    var cheatCount = 0;
    var MAX_CHEATS = 3;
    var isAnswered = false;
    var userAnswers = new Array(50).fill(null);

    function validateAndStart() {
      var nameInput = document.getElementById("student-name").value.trim();
      var classInput = document.getElementById("student-class").value.trim();

      if (nameInput === "" || classInput === "") {
        alert("Harap isi Nama Lengkap dan Kelas terlebih dahulu!");
        return;
      }

      studentName = nameInput;
      studentClass = classInput;

      document.getElementById("display-student-info").innerText = "Siswa: " + studentName + " | Kelas: " + studentClass;
      
      // Inisialisasi AudioContext saat tombol diklik pertama kali oleh user
      initAudioContext();
      startQuiz();
    }

    document.addEventListener("visibilitychange", function() {
      if (document.hidden && document.getElementById("start-screen").style.display === "none") {
        handleCheatViolation("Terdeteksi meninggalkan aplikasi kuis!");
      }
    });

    window.addEventListener("blur", function() {
      if (document.getElementById("start-screen").style.display === "none") {
        handleCheatViolation("Terdeteksi keluar dari jendela kuis!");
      }
    });

    document.addEventListener("contextmenu", function(e) { e.preventDefault(); });
    document.addEventListener("keydown", function(e) {
      if (e.key === "F12" || (e.ctrlKey && e.shiftKey && (e.key === "I" || e.key === "J")) || (e.ctrlKey && e.key === "u")) {
        e.preventDefault();
        handleCheatViolation("Terdeteksi mencoba membuka DevTools!");
      }
    });

    function handleCheatViolation(reason) {
      cheatCount++;
      clearInterval(timerInterval);
      
      var cheatScreen = document.getElementById("cheat-screen");
      var cheatTitle = document.getElementById("cheat-title");
      var cheatMsg = document.getElementById("cheat-msg");

      if (cheatCount >= MAX_CHEATS) {
        cheatTitle.innerText = "DISKUALIFIKASI!";
        cheatMsg.innerText = "Anda telah melanggar aturan anti-curang sebanyak 3 kali.\nKuis dihentikan dan data pelanggaran tercatat.";
        cheatScreen.querySelector("button").style.display = "none";
        cheatScreen.style.display = "flex";
        sendDataToGoogleSheets();
      } else {
        cheatTitle.innerText = `PERINGATAN CURANG (${cheatCount}/${MAX_CHEATS})`;
        cheatMsg.innerText = reason + "\n\nJangan tinggalkan kuis atau membuka tab lain!";
        cheatScreen.style.display = "flex";
      }
    }

    function resumeQuiz() {
      document.getElementById("cheat-screen").style.display = "none";
      if (currentQIndex !== -1 && !isAnswered) startTimer();
    }

    function startQuiz() {
      document.getElementById("start-screen").style.display = "none";
      renderGridTiles();
    }

    function renderGridTiles() {
      var gridContainer = document.getElementById("tiles-container");
      gridContainer.innerHTML = "";
      for (var i = 0; i < selectedQuestions.length; i++) {
        var btn = document.createElement("button");
        btn.className = "tile-btn";
        btn.id = "tile-" + i;
        btn.innerText = (i + 1);
        btn.onclick = (function(idx) {
          return function() { openQuestionModal(idx); };
        })(i);
        gridContainer.appendChild(btn);
      }
    }

    function openQuestionModal(index) {
      if (userAnswers[index] !== null) return;

      currentQIndex = index;
      isAnswered = false;
      timeLeft = QUESTION_TIME;

      var qData = selectedQuestions[currentQIndex];
      document.getElementById("question-text").innerText = qData.q;
      
      var audioBtn = document.getElementById("audio-play-btn");
      if (qData.audio) {
        audioBtn.style.display = "inline-flex";
        playQuestionSound();
      } else {
        audioBtn.style.display = "none";
      }

      var shuffledOptions = shuffleArray(qData.options);
      var grid = document.getElementById("options-grid");
      grid.innerHTML = "";

      shuffledOptions.forEach(function(optText) {
        var btn = document.createElement("button");
        btn.className = "opt-btn";
        btn.innerText = optText;
        btn.onclick = function() { selectAnswer(btn, optText, qData.correctText); };
        grid.appendChild(btn);
      });

      document.getElementById("modal-overlay").style.display = "flex";
      startTimer();
    }

    function closeModalDirectly() {
      clearInterval(timerInterval);
      document.getElementById("modal-overlay").style.display = "none";
      currentQIndex = -1;
    }

    function playQuestionSound() {
      if (currentQIndex !== -1 && selectedQuestions[currentQIndex].audio) {
        playAudioPattern(selectedQuestions[currentQIndex].audio);
      }
    }

    function startTimer() {
      updateTimerUI();
      timerInterval = setInterval(function() {
        timeLeft--;
        updateTimerUI();

        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          timeOutAnswer();
        }
      }, 1000);
    }

    function updateTimerUI() {
      var minutes = Math.floor(timeLeft / 60);
      var seconds = timeLeft % 60;
      var timeStr = (minutes < 10 ? "0" : "") + minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
      
      document.getElementById("timer-text").innerText = timeStr;
      
      var percentage = (timeLeft / QUESTION_TIME) * 100;
      var bar = document.getElementById("timer-bar");
      bar.style.width = percentage + "%";

      if (timeLeft <= 10) {
        bar.style.background = "#e63946";
      } else if (timeLeft <= 30) {
        bar.style.background = "#e76f51";
      } else {
        bar.style.background = "linear-gradient(90deg, #2a9d8f, #e76f51)";
      }
    }

    function selectAnswer(selectedBtn, selectedText, correctText) {
      if (isAnswered) return;
      isAnswered = true;
      clearInterval(timerInterval);

      var isCorrect = (selectedText === correctText);
      userAnswers[currentQIndex] = isCorrect;
      answeredCount++;

      var allBtns = document.querySelectorAll(".opt-btn");
      allBtns.forEach(function(btn) {
        btn.disabled = true;
        if (btn.innerText === correctText) {
          btn.classList.add("correct");
        } else if (btn === selectedBtn && !isCorrect) {
          btn.classList.add("wrong");
        }
      });

      var tile = document.getElementById("tile-" + currentQIndex);
      if (isCorrect) {
        correctAnswersCount++;
        tile.classList.add("correct");
      } else {
        tile.classList.add("wrong");
      }
      tile.disabled = true;

      updateOverallProgress();

      setTimeout(function() {
        document.getElementById("modal-overlay").style.display = "none";
        currentQIndex = -1;
      }, 1000);
    }

    function timeOutAnswer() {
      if (isAnswered) return;
      isAnswered = true;
      userAnswers[currentQIndex] = false;
      answeredCount++;

      var qData = selectedQuestions[currentQIndex];
      var allBtns = document.querySelectorAll(".opt-btn");
      
      allBtns.forEach(function(btn) {
        btn.disabled = true;
        if (btn.innerText === qData.correctText) {
          btn.classList.add("correct");
        }
      });

      var tile = document.getElementById("tile-" + currentQIndex);
      tile.classList.add("wrong");
      tile.disabled = true;

      updateOverallProgress();

      setTimeout(function() {
        document.getElementById("modal-overlay").style.display = "none";
        currentQIndex = -1;
      }, 1000);
    }

    function updateOverallProgress() {
      var calculatedScore = (correctAnswersCount / selectedQuestions.length) * 100;
      document.getElementById("q-counter").innerText = `Terjawab: ${answeredCount} / ${selectedQuestions.length} Soal`;
      document.getElementById("score-badge").innerText = "Skor: " + Math.round(calculatedScore);

      document.getElementById("finish-btn").style.display = "inline-block";
    }

    function sendDataToGoogleSheets() {
      var finalScore = Math.round((correctAnswersCount / selectedQuestions.length) * 100);
      var payload = {
        timestamp: new Date().toLocaleString("id-ID"),
        nama: studentName,
        kelas: studentClass,
        benar: correctAnswersCount,
        totalSoal: selectedQuestions.length,
        skor: finalScore,
        pelanggaran: cheatCount
      };

      if (SCRIPT_URL && SCRIPT_URL.indexOf("AKfycb") !== -1) {
        fetch(SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        }).catch(function(err) {
          console.error("Gagal mengirim data:", err);
        });
      }
    }

    function finishQuiz() {
      clearInterval(timerInterval);
      var finalScore = Math.round((correctAnswersCount / selectedQuestions.length) * 100);
      
      sendDataToGoogleSheets();

      document.body.innerHTML = `
        <div style="min-height:100vh; display:flex; flex-direction:column; justify-content:center; align-items:center; background:#0d1b2a; color:#fff; text-align:center; padding:20px;">
          <h1 style="color:#f4a261; font-size:26px; margin-bottom:15px;">KUIS SELESAI! 🏆</h1>
          <p style="color:#2a9d8f; font-size:14px; margin-bottom:20px;">Data nilai Anda telah berhasil terdata di sistem Google Sheets.</p>
          <div style="background:#1b263b; border:2px solid #2a9d8f; padding:20px; border-radius:15px; width:100%; max-width:350px; margin-bottom:20px; text-align:left;">
            <p style="font-size:15px; margin-bottom:8px; color:#f4a261;">Nama: <strong>${studentName}</strong></p>
            <p style="font-size:15px; margin-bottom:15px; color:#f4a261;">Kelas: <strong>${studentClass}</strong></p>
            <hr style="border:0; border-top:1px solid #415a77; margin-bottom:15px;">
            <p style="font-size:16px; margin-bottom:10px;">Soal Terjawab: <strong>${answeredCount} / ${selectedQuestions.length} Soal</strong></p>
            <p style="font-size:16px; margin-bottom:10px;">Jawaban Benar: <strong style="color:#2a9d8f;">${correctAnswersCount} Soal</strong></p>
            <p style="font-size:16px; margin-bottom:10px;">Pelanggaran Curang: <strong style="color:${cheatCount > 0 ? '#e63946' : '#2a9d8f'};">${cheatCount} Kali</strong></p>
            <p style="font-size:22px; font-weight:bold; color:#2a9d8f; margin-top:10px;">Nilai Akhir: ${finalScore}</p>
          </div>
          <button onclick="location.reload()" style="background:#2a9d8f; color:#fff; font-size:16px; font-weight:bold; padding:12px 30px; border:none; border-radius:25px; cursor:pointer;">KEMBALI KE HALAMAN UTAMA</button>
        </div>
      `;
    }
  </script>
