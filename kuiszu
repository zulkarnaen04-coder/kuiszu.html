  <script>
    // Data Soal Lengkap 1 - 100
    var allQuestions = [
      // 1 
      { q: "Penggunaan metronome pada komputer saat latihan bertujuan utama untuk...", options: ["Menentukan kencangnya suara nyanyian", "Menjaga ketepatan dan konsistensi tempo", "Mengatur tinggi rendahnya nada angklung", "Menggantikan peran guru dalam mengajar"], correctText: "Menjaga ketepatan dan konsistensi tempo" },
      { q: "Rentang tempo 60-70 BPM yang digunakan guru termasuk dalam kategori tempo...", options: ["Sangat cepat (Presto)", "Cepat (Allegro)", "Sedang/Lambat (Andante / Adagio)", "Sangat cepat sekali (Prestissimo)"], correctText: "Sedang/Lambat (Andante / Adagio)" },
      { q: "Penghitungan angka \"1, 2, 3, 4\" yang dinyanyikan secara keras bertujuan untuk...", options: ["Membantu siswa merasakan ketukan (beat) secara pasti", "Menghafal lirik lagu Ibu Kita Kartini", "Melatih kemampuan vokal nada tinggi", "Menentukan akor lagu yang akan dimainkan"], correctText: "Membantu siswa merasakan ketukan (beat) secara pasti" },
      { q: "Istilah BPM dalam pengaturan tempo musik merupakan singkatan dari...", options: ["Beat Per Minute", "Bass Per Minute", "Bar Per Minute", "Band Per Minute"], correctText: "Beat Per Minute" },
      { q: "Ketika tepuk tangan dilakukan pada setiap suku kata nama sesuai beat metronom, kegiatan tersebut melatih...", options: ["Harmoni vokal", "Artikulasi nada", "Sensitivitas ritme dan tempo", "Ketangkasan bermain angklung"], correctText: "Sensitivitas ritme dan tempo" },
      { q: "Jika nama seorang siswa adalah \"SAB-RI-NA\", maka jumlah tepukan tangan yang dilakukan sesuai beat adalah...", options: ["2 tepukan", "3 tepukan", "4 tepukan", "5 tepukan"], correctText: "3 tepukan" },
      { q: "Satuan untuk mengukur kecepatan tempo musik adalah...", options: ["Hertz (Hz)", "Decibel (dB)", "Beat Per Minute (BPM)", "Oktav"], correctText: "Beat Per Minute (BPM)" },
      { q: "Perubahan tempo dari 60 BPM menjadi 70 BPM menandakan bahwa musik berjalan...", options: ["Semakin lambat", "Semakin cepat", "Semakin keras", "Semakin pelan"], correctText: "Semakin cepat" },
      { q: "Menghitung \"1, 2, 3, 4\" secara berulang mengindikasikan bahwa lagu yang dipelajari menggunakan birama...", options: ["2/4", "3/4", "4/4", "6/8"], correctText: "4/4" },
      { q: "Fungsi alat musik metronom dalam sebuah ansambel musik adalah sebagai...", options: ["Penentu melodi utama", "Acuan tempo dan ritme dasar", "Pengatur dinamika suara", "Pelengkap nada bass"], correctText: "Acuan tempo dan ritme dasar" },

      { q: "Kegiatan tepuk tangan ke arah depan, kiri, kanan, dan atas melatih keterampilan...", options: ["Peningkatan jangkauan nada", "Koordinasi motorik dan kepekaan ritmis", "Penguasaan instrumen terompet", "Teknik pernapasan diafragma"], correctText: "Koordinasi motorik dan kepekaan ritmis" },
      { q: "Urutan tepukan pada tahapan ke-3 skenario pembelajaran adalah...", options: ["Depan -> Kiri -> Kanan -> Atas", "Paha -> Kiri -> Kanan -> Atas", "Atas -> Paha -> Kanan -> Kiri", "Kiri -> Kanan -> Depan -> Atas"], correctText: "Paha -> Kiri -> Kanan -> Atas" },
      { q: "Aktivitas berdiri, mengangkat kaki kanan, mengangkat kaki kiri, lalu menghadap kanan dan kiri bermanfaat untuk...", options: ["Menghafal nada C, D, E, F, G", "Menyelaraskan gerak tubuh dengan ketukan tempo", "Mengatur pernapasan saat bernyanyi", "Memilih instrumen yang tepat"], correctText: "Menyelaraskan gerak tubuh dengan ketukan tempo" },
      { q: "Penggunaan gerak anggota tubuh untuk menghasilkan ritme musik disebut...", options: ["Vokal grup", "Body percussion (Perkusi tubuh)", "Solfeggio", "Akustik"], correctText: "Body percussion (Perkusi tubuh)" },
      { q: "Gerakan tubuh yang tidak sesuai dengan ketukan metronom menunjukkan bahwa siswa...", options: ["Belum menjaga konsistensi tempo", "Memiliki nada vokal yang bagus", "Sudah menguasai akor C Mayor", "Sangat mahir bermain drum"], correctText: "Belum menjaga konsistensi tempo" },
      { q: "Saat tepuk tangan mengarah ke paha pada hitungan ke-3, yang harus diperhatikan adalah...", options: ["Bunyi suara vokal", "Ketepatan waktu tepukan dengan bunyi metronom", "Kerentanan alat musik angklung", "Pencahayaan dari proyektor"], correctText: "Ketepatan waktu tepukan dengan bunyi metronom" },
      { q: "Latihan variasi arah tepukan termasuk bentuk pembelajaran kinestetik untuk...", options: ["Memahami tempo secara visual", "Memahami tempo secara auditori dan fisik", "Memahami harmoni akor", "Menghafal lirik lagu"], correctText: "Memahami tempo secara auditori dan fisik" },
      { q: "Jika satu gerakan dilakukan setiap 1 beat pada tempo 60 BPM, maka jeda waktu antar gerakan adalah...", options: ["0,5 detik", "1,0 detik", "2,0 detik", "1,5 detik"], correctText: "1,0 detik" },
      { q: "Manfaat utama menggabungkan gerak fisik dengan tempo musik pada siswa SMP adalah...", options: ["Agar siswa cepat lelah", "Memudahkan pemahaman konsep ritme secara nyata", "Mengurangi durasi waktu belajar", "Mengganti kebutuhan alat musik"], correctText: "Memudahkan pemahaman konsep ritme secara nyata" },
      { q: "Fokus utama guru saat memberikan latihan gerakan kaki dan tepukan adalah...", options: ["Keseragaman tinggi badan siswa", "Kecepatan reaksi tubuh terhadap beat tempo", "Keindahan pakaian siswa", "Volume suara nyanyian siswa"], correctText: "Kecepatan reaksi tubuh terhadap beat tempo" },

      { q: "Pada simulasi drumset, anggota tubuh yang dimainkan bersamaan pada hitungan 1 dan 3 adalah...", options: ["Tangan kanan dan tangan kiri", "Kaki kanan dan tangan kanan", "Kaki kiri dan tangan kiri", "Kaki kanan dan tangan kiri"], correctText: "Kaki kanan dan tangan kanan" },
      { q: "Anggota tubuh yang dimainkan bersamaan pada hitungan 2 dan 4 adalah...", options: ["Kaki kanan dan tangan kanan", "Tangan kanan dan tangan kiri", "Kaki kiri dan tangan kiri", "Kaki kanan dan kaki kiri"], correctText: "Tangan kanan dan tangan kiri" },
